{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo nextest *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo doc *)",
      "Bash(cargo run *)",
      "Bash(cargo xtask *)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(cargo deny *)",
      "Bash(typos *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh repo view *)",
      "PowerShell(cargo build *)",
      "PowerShell(cargo check *)",
      "PowerShell(cargo test *)",
      "PowerShell(cargo nextest *)",
      "PowerShell(cargo clippy *)",
      "PowerShell(cargo fmt *)",
      "PowerShell(cargo doc *)",
      "PowerShell(cargo run *)",
      "PowerShell(cargo xtask *)",
      "PowerShell(cargo tree *)",
      "PowerShell(cargo metadata *)",
      "PowerShell(cargo deny *)",
      "PowerShell(typos *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git fetch *)",
      "PowerShell(git switch *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh run view *)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:docs.vulkan.org)",
      "WebFetch(domain:registry.khronos.org)",
      "WebFetch(domain:wiki.libsdl.org)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:code.claude.com)"
    ],
    "ask": [
      "Bash(cargo add *)",
      "Bash(cargo update *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git tag *)",
      "PowerShell(cargo add *)",
      "PowerShell(cargo update *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh release *)",
      "PowerShell(git rebase *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git tag *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(cargo publish *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f)",
      "PowerShell(git push origin main*)",
      "PowerShell(git push origin HEAD:main*)",
      "PowerShell(cargo publish *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.mobileprovision)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.rs)",
            "command": "cargo",
            "args": ["fmt", "--all"],
            "timeout": 60,
            "statusMessage": "cargo fmt"
          },
          {
            "type": "command",
            "if": "Write(*.rs)",
            "command": "cargo",
            "args": ["fmt", "--all"],
            "timeout": 60,
            "statusMessage": "cargo fmt"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  }
}
