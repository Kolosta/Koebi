#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Text editing"
msgstr "テキスト編集"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Ends the edit and keeps the text."
msgstr "編集を終了し、テキストを確定します。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Ends the edit and restores the text it started with."
msgstr "編集を終了し、編集前のテキストに戻します。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Next field"
msgstr "次のフィールド"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Keeps the text and edits the next field."
msgstr "テキストを確定し、次のフィールドを編集します。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Previous field"
msgstr "前のフィールド"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Keeps the text and edits the previous field."
msgstr "テキストを確定し、前のフィールドを編集します。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Moves the caret one character left."
msgstr "キャレットを1文字左へ移動します。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Moves the caret one character right."
msgstr "キャレットを1文字右へ移動します。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Word left"
msgstr "前の単語"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Moves the caret to the start of the word before it."
msgstr "キャレットを前の単語の先頭へ移動します。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Word right"
msgstr "次の単語"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Moves the caret to the end of the word after it."
msgstr "キャレットを次の単語の末尾へ移動します。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Moves the caret to the start of the text."
msgstr "キャレットをテキストの先頭へ移動します。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Moves the caret to the end of the text."
msgstr "キャレットをテキストの末尾へ移動します。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Select left"
msgstr "左を選択"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Extends the selection one character left."
msgstr "選択範囲を1文字左へ広げます。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Select right"
msgstr "右を選択"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Extends the selection one character right."
msgstr "選択範囲を1文字右へ広げます。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Select word left"
msgstr "前の単語まで選択"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Extends the selection to the start of the word before the caret."
msgstr "選択範囲をキャレットの前の単語の先頭まで広げます。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Select word right"
msgstr "次の単語まで選択"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Extends the selection to the end of the word after the caret."
msgstr "選択範囲をキャレットの次の単語の末尾まで広げます。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Select to start"
msgstr "先頭まで選択"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Extends the selection to the start of the text."
msgstr "選択範囲をテキストの先頭まで広げます。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Select to end"
msgstr "末尾まで選択"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Extends the selection to the end of the text."
msgstr "選択範囲をテキストの末尾まで広げます。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Select all"
msgstr "すべて選択"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Selects the whole text."
msgstr "テキスト全体を選択します。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Delete backward"
msgstr "前を削除"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Deletes the selection, or the character before the caret."
msgstr "選択範囲、またはキャレットの前の文字を削除します。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Delete forward"
msgstr "後ろを削除"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Deletes the selection, or the character after the caret."
msgstr "選択範囲、またはキャレットの後ろの文字を削除します。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Delete word backward"
msgstr "前の単語を削除"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Deletes the selection, or the word before the caret."
msgstr "選択範囲、またはキャレットの前の単語を削除します。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Delete word forward"
msgstr "次の単語を削除"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Deletes the selection, or the word after the caret."
msgstr "選択範囲、またはキャレットの後ろの単語を削除します。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Copy"
msgstr "コピー"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Copies the selected text to the clipboard."
msgstr "選択したテキストをクリップボードにコピーします。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Cut"
msgstr "切り取り"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Copies the selected text to the clipboard and deletes it."
msgstr "選択したテキストをクリップボードにコピーして削除します。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Paste"
msgstr "貼り付け"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Replaces the selection with the clipboard's text."
msgstr "選択範囲をクリップボードのテキストで置き換えます。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Undo"
msgstr "元に戻す"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Undoes the last change to the text being edited."
msgstr "編集中のテキストの直前の変更を元に戻します。"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Redo"
msgstr "やり直し"

#: crates/koebi-ui/src/widgets/text_field/actions.rs
msgid "Redoes the last change undone in the text being edited."
msgstr "編集中のテキストで元に戻した変更をやり直します。"

